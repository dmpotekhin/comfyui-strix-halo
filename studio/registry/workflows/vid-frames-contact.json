{
  "id": "vid-frames-contact",
  "name": "Frames — contact sheet frames",
  "category": "video-generation",
  "description": "A frame every five seconds, at most twelve: exactly what a contact sheet needs.",
  "execution": "host",
  "host_tool": "ffmpeg_extract_frames",
  "output_kind": "image",
  "timeout_s": 900,
  "min_vram_gb": 0,
  "tags": [
    "video",
    "frames",
    "contact-sheet",
    "host-tool",
    "no-gpu",
    "no-download"
  ],
  "models": [],
  "parameters": [
    {
      "key": "video",
      "label": "Video file (name in input/ or path in project)",
      "type": "string",
      "default": "output/studio/i2v_00002_.mp4",
      "required": true
    },
    {
      "key": "fps",
      "label": "Frames per second to sample",
      "type": "float",
      "default": 0.2,
      "min": 0.01,
      "max": 60,
      "step": 0.01
    },
    {
      "key": "max_frames",
      "label": "Max frames",
      "type": "int",
      "default": 12,
      "min": 1,
      "max": 120
    }
  ],
  "notes": "Each run writes its own `frames_<name>_setNNN/` folder, so two extractions of the same clip never overwrite or interleave."
}
