          "4",
          0
        ]
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "5",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/style_anime",
        "images": [
          "6",
          0
        ]
      }
    }
  },
  "output_kind": "image",
  "timeout_s": 900,
  "min_vram_gb": 8,
  "tags": [
    "style",
    "anime",
    "animagine",
    "no-download"
