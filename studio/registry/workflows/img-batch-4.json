{
  "id": "img-batch-4",
  "name": "Batch — four takes of one prompt",
  "category": "image-generation",
  "description": "Four images from one prompt in a single pass — the fastest way to shop for a composition before spending steps on one seed.",
  "execution": "graph",
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_turbo_1.0_fp16.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "a friendly red fox in autumn grass, golden hour, photographic",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, watermark, text, deformed, extra fingers",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 4
      }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 42,
        "steps": 4,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": [
          "1",
          0
        ],
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "4",
          0
        ]
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "5",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/batch4",
        "images": [
          "6",
          0
        ]
      }
    }
  },
  "output_kind": "image",
  "timeout_s": 300,
  "min_vram_gb": 10,
  "tags": [
    "batch",
    "explore",
    "sdxl-turbo",
    "no-download"
  ],
  "models": [
    {
      "folder": "checkpoints",
      "file": "sd_xl_turbo_1.0_fp16.safetensors",
      "purpose": "SDXL-Turbo base model (4-step sampling)"
    }
  ],
  "parameters": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "multiline": true,
      "default": "a friendly red fox in autumn grass, golden hour, photographic",
      "required": true,
      "bind": {
        "node": "2",
        "input": "text"
      }
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "multiline": true,
      "default": "blurry, low quality, watermark, text, deformed, extra fingers",
      "bind": {
        "node": "3",
        "input": "text"
      }
    },
    {
      "key": "batch_size",
      "label": "Images",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 8,
      "bind": {
        "node": "4",
        "input": "batch_size"
      }
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 20,
      "bind": {
        "node": "5",
        "input": "steps"
      }
    },
    {
      "key": "cfg",
      "label": "CFG scale",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 12.0,
      "step": 0.1,
      "bind": {
        "node": "5",
        "input": "cfg"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 42,
      "bind": {
        "node": "5",
        "input": "seed"
      }
    }
  ],
  "notes": "Batch 4 at 1024² fits comfortably in 32 GB unified memory; above 6 the sampler starts competing with the text encoder for space."
}
