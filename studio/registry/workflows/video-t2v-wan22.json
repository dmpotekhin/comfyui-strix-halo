{
  "id": "video-t2v-wan22",
  "name": "Text to Video — Wan 2.2 TI2V-5B",
  "category": "video-generation",
  "description": "Generates a short clip from a prompt alone. Same Wan 2.2 TI2V-5B stack as the image-to-video workflow, with the start image and CLIP-vision conditioning removed.",
  "output_kind": "video",
  "timeout_s": 2400,
  "min_vram_gb": 24,
  "tags": [
    "video",
    "t2v",
    "wan",
    "animation",
    "mp4"
  ],
  "test_status": "untested",
  "models": [
    {
      "folder": "diffusion_models",
      "file": "wan2.2_ti2v_5B_fp16.safetensors",
      "purpose": "video diffusion model"
    },
    {
      "folder": "text_encoders",
      "file": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "purpose": "text encoder (T5)"
    },
    {
      "folder": "vae",
      "file": "wan2.2_vae.safetensors",
      "purpose": "video VAE"
    }
  ],
  "notes": "UNVERIFIED VARIANT. 'start_image' is an optional input of WanImageToVideo, so omitting it should yield pure text conditioning, but the installed graph that is known to work always supplied a start image. Treat this workflow as ready-to-test, not as a working capability, until a run has actually succeeded on this machine.",
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan2.2_vae.safetensors"
      }
    },
    "8": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": "a small orange cat walks through tall summer grass, gentle wind, warm afternoon light, slow camera push in"
      }
    },
    "9": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": "static, freeze frame, blurry, worst quality, low quality, distorted, deformed, extra limbs, text, watermark, subtitles, jitter, flicker"
      }
    },
    "10": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": 8.0
      }
    },
    "11": {
      "class_type": "WanImageToVideo",
      "inputs": {
        "positive": [
          "8",
          0
        ],
        "negative": [
          "9",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "width": 640,
        "height": 640,
        "length": 49,
        "batch_size": 1
      }
    },
    "12": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "10",
          0
        ],
        "seed": 777,
        "steps": 30,
        "cfg": 5.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "positive": [
          "11",
          0
        ],
        "negative": [
          "11",
          1
        ],
        "latent_image": [
          "11",
          2
        ],
        "denoise": 1.0
      }
    },
    "13": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "12",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "14": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "13",
          0
        ],
        "fps": 24.0
      }
    },
    "15": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "14",
          0
        ],
        "filename_prefix": "studio/t2v",
        "format": "mp4",
        "codec": "h264"
      }
    }
  },
  "parameters": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "bind": {
        "node": "8",
        "input": "text"
      },
      "required": true,
      "multiline": true,
      "default": "a small orange cat walks through tall summer grass, gentle wind, warm afternoon light, slow camera push in"
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "bind": {
        "node": "9",
        "input": "text"
      },
      "multiline": true,
      "default": "static, freeze frame, blurry, worst quality, low quality, distorted, deformed, extra limbs, text, watermark, subtitles, jitter, flicker"
    },
    {
      "key": "width",
      "label": "Width",
      "type": "int",
      "bind": {
        "node": "11",
        "input": "width"
      },
      "default": 640,
      "min": 256,
      "max": 1024,
      "step": 64,
      "unit": "px",
      "description": "The file comes out at 2x this value: WAN 2.2 TI2V decodes at double the requested size (measured 320 -> 640x640 in 41 s, 640 -> 1280x1280 in ~27 min). 640 means a real 1280x1280 clip."
    },
    {
      "key": "height",
      "label": "Height",
      "type": "int",
      "bind": {
        "node": "11",
        "input": "height"
      },
      "default": 640,
      "min": 256,
      "max": 1024,
      "step": 64,
      "unit": "px",
      "description": "The file comes out at 2x this value: WAN 2.2 TI2V decodes at double the requested size (measured 320 -> 640x640 in 41 s, 640 -> 1280x1280 in ~27 min). 640 means a real 1280x1280 clip."
    },
    {
      "key": "length",
      "label": "Frames",
      "type": "int",
      "bind": {
        "node": "11",
        "input": "length"
      },
      "default": 49,
      "min": 17,
      "max": 121,
      "step": 4
    },
    {
      "key": "fps",
      "label": "FPS",
      "type": "float",
      "bind": {
        "node": "14",
        "input": "fps"
      },
      "default": 24.0,
      "min": 8.0,
      "max": 30.0,
      "step": 1.0
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "bind": {
        "node": "12",
        "input": "steps"
      },
      "default": 30,
      "min": 10,
      "max": 50
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "bind": {
        "node": "12",
        "input": "cfg"
      },
      "default": 5.0,
      "min": 1.0,
      "max": 10.0,
      "step": 0.5
    },
    {
      "key": "shift",
      "label": "Sampling shift",
      "type": "float",
      "bind": {
        "node": "10",
        "input": "shift"
      },
      "default": 8.0,
      "min": 1.0,
      "max": 20.0,
      "step": 0.5
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "bind": {
        "node": "12",
        "input": "seed"
      },
      "default": -1,
      "seed_source": true
    }
  ]
}
