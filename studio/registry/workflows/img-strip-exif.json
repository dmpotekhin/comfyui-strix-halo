{
  "id": "img-strip-exif",
  "name": "Strip — remove EXIF and metadata",
  "category": "image-editing",
  "description": "Rewrites the picture with no EXIF block: no GPS coordinates, no camera serial, no software tag.",
  "execution": "host",
  "host_tool": "image_strip_metadata",
  "output_kind": "image",
  "timeout_s": 900,
  "min_vram_gb": 0,
  "tags": [
    "host-tool",
    "no-gpu",
    "image_strip_metadata"
  ],
  "models": [],
  "parameters": [
    {
      "key": "image",
      "label": "Photo",
      "type": "image",
      "default": "ref_raccoon.png",
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      }
    },
    {
      "key": "format",
      "label": "Output format",
      "type": "choice",
      "options": [
        "jpg",
        "png",
        "webp"
      ],
      "default": "jpg"
    },
    {
      "key": "quality",
      "label": "JPEG quality",
      "type": "int",
      "default": 92,
      "min": 1,
      "max": 100
    }
  ],
  "notes": "The image is decoded and re-encoded, so the pixels are identical apart from the chosen quality; the metadata is simply not written."
}
