{
  "id": "img2img-anime",
  "name": "Restyle — photo to anime (Animagine)",
  "category": "image-editing",
  "description": "Animagine XL 4.0 at denoise 0.55: keeps the pose and framing, swaps the medium to anime. Needs an alpha-free photo of at least 512 px.",
  "execution": "graph",
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "animagine-xl-4.0.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "masterpiece, high score, anime style, detailed lineart, soft cel shading, atmospheric background",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "lowres, worst quality, low quality, text, signature, watermark, blurry, bad anatomy",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "ref_raccoon.png"
      }
    },
    "5": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "4",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 7,
        "steps": 28,
        "cfg": 6.0,
        "sampler_name": "euler_ancestral",
        "scheduler": "normal",
        "denoise": 0.55,
        "model": [
          "1",
          0
        ],
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "5",
          0
        ]
      }
    },
    "7": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "6",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "8": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/restyle_anime",
        "images": [
          "7",
          0
        ]
      }
    }
  },
  "output_kind": "image",
  "timeout_s": 900,
  "min_vram_gb": 10,
  "tags": [
    "img2img",
    "anime",
    "animagine",
    "no-download"
  ],
  "models": [
    {
      "folder": "checkpoints",
      "file": "animagine-xl-4.0.safetensors",
      "purpose": "Animagine XL 4.0 anime checkpoint"
    }
  ],
  "parameters": [
    {
      "key": "image",
      "label": "Photo",
      "type": "image",
      "default": "ref_raccoon.png",
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      },
      "bind": {
        "node": "4",
        "input": "image"
      }
    },
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "multiline": true,
      "default": "masterpiece, high score, anime style, detailed lineart, soft cel shading, atmospheric background",
      "required": true,
      "bind": {
        "node": "2",
        "input": "text"
      }
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "multiline": true,
      "default": "lowres, worst quality, low quality, text, signature, watermark, blurry, bad anatomy",
      "bind": {
        "node": "3",
        "input": "text"
      }
    },
    {
      "key": "denoise",
      "label": "Denoise",
      "type": "float",
      "default": 0.55,
      "min": 0.3,
      "max": 0.9,
      "step": 0.05,
      "bind": {
        "node": "6",
        "input": "denoise"
      }
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 28,
      "min": 8,
      "max": 50,
      "bind": {
        "node": "6",
        "input": "steps"
      }
    },
    {
      "key": "cfg",
      "label": "CFG scale",
      "type": "float",
      "default": 6.0,
      "min": 0.0,
      "max": 12.0,
      "step": 0.1,
      "bind": {
        "node": "6",
        "input": "cfg"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 7,
      "bind": {
        "node": "6",
        "input": "seed"
      }
    }
  ]
}
