{
  "id": "asr-all-formats",
  "name": "Transcript — txt + SRT + VTT + JSON at once",
  "category": "audio-generation",
  "description": "One pass, four files — the archive export.",
  "execution": "host",
  "host_tool": "whisper_transcribe",
  "output_kind": "text",
  "timeout_s": 1800,
  "min_vram_gb": 0,
  "tags": [
    "asr",
    "whisper",
    "subtitles",
    "host-tool",
    "no-gpu",
    "no-download"
  ],
  "models": [
    {
      "folder": "host:studio/tools/whisper-models",
      "file": "ggml-small.bin",
      "purpose": "whisper.cpp small — CPU transcription"
    }
  ],
  "parameters": [
    {
      "key": "audio",
      "label": "Audio or video file",
      "type": "string",
      "default": "output/studio/tts_ru_RU_00001_.wav",
      "required": true
    },
    {
      "key": "language",
      "label": "Language",
      "type": "choice",
      "options": [
        "auto",
        "ru",
        "en",
        "de",
        "fr",
        "es",
        "it",
        "zh",
        "ja"
      ],
      "default": "auto"
    },
    {
      "key": "formats",
      "label": "Output formats (comma separated)",
      "type": "string",
      "default": "txt,srt,vtt,json"
    }
  ],
  "notes": "whisper.cpp small on the CPU is fast enough for minutes of speech; it will struggle with heavy accents and noisy recordings, which is exactly what the large-v3 proposal in Stage S is about."
}
