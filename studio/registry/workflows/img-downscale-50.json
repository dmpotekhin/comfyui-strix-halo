{
  "id": "img-downscale-50",
  "name": "Image — halve the size",
  "category": "image-enhancement",
  "description": "Halves an image with area-quality sampling, which is what makes a downscale look clean instead of aliased.",
  "execution": "graph",
  "graph": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "ref_raccoon.png"
      }
    },
    "2": {
      "class_type": "ImageScaleBy",
      "inputs": {
        "image": [
          "1",
          0
        ],
        "upscale_method": "area",
        "scale_by": 0.5
      }
    },
    "3": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/down50",
        "images": [
          "2",
          0
        ]
      }
    }
  },
  "output_kind": "image",
  "timeout_s": 120,
  "min_vram_gb": 8,
  "tags": [
    "resize",
    "downscale",
    "area",
    "no-model"
  ],
  "models": [],
  "parameters": [
    {
      "key": "image",
      "label": "Photo",
      "type": "image",
      "default": "ref_raccoon.png",
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      },
      "bind": {
        "node": "1",
        "input": "image"
      }
    },
    {
      "key": "scale_by",
      "label": "Scale",
      "type": "float",
      "default": 0.5,
      "min": 0.1,
      "max": 1.0,
      "step": 0.05,
      "bind": {
        "node": "2",
        "input": "scale_by"
      }
    }
  ]
}
