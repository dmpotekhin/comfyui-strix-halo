{
  "id": "img-convert-png",
  "name": "Convert — to PNG (lossless)",
  "category": "image-editing",
  "description": "Lossless PNG, alpha preserved — the right choice before any further processing or an inpainting pass.",
  "execution": "host",
  "host_tool": "image_convert",
  "output_kind": "image",
  "timeout_s": 900,
  "min_vram_gb": 0,
  "tags": [
    "host-tool",
    "no-gpu",
    "image_convert"
  ],
  "models": [],
  "parameters": [
    {
      "key": "image",
      "label": "Photo",
      "type": "image",
      "default": "ref_raccoon.png",
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      }
    },
    {
      "key": "format",
      "label": "Output format",
      "type": "choice",
      "options": [
        "png",
        "jpg",
        "webp"
      ],
      "default": "png"
    },
    {
      "key": "quality",
      "label": "Quality (ignored for PNG)",
      "type": "int",
      "default": 88,
      "min": 1,
      "max": 100
    },
    {
      "key": "max_side",
      "label": "Max longest side (0 = keep)",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 8192
    }
  ],
  "notes": null
}
