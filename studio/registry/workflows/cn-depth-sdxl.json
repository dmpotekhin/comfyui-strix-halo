{
  "id": "cn-depth-sdxl",
  "name": "Depth-guided generation — host depth map → SDXL Depth ControlNet",
  "category": "image-generation",
  "description": "Keeps the 3D layout of a photo and repaints it in a new style. Unlike the edge workflow this one reads the geometry: Depth-Anything V2 Small predicts a depth map on the host CPU (no VRAM, no OpenCV in the container), drops it into ComfyUI's input folder, and the depth ControlNet passes it to SDXL Turbo. One job, one photo in, a stylised image out.",
  "execution": "chain",
  "host_tool": "depth_map",
  "chain_bind": {
    "node": "4",
    "input": "image"
  },
  "output_kind": "image",
  "min_vram_gb": 12,
  "timeout_s": 900,
  "tags": [
    "depth",
    "controlnet",
    "structure",
    "composition",
    "sdxl",
    "turbo",
    "host-tool"
  ],
  "models": [
    {
      "folder": "checkpoints",
      "file": "sd_xl_turbo_1.0_fp16.safetensors",
      "purpose": "base sampler"
    },
    {
      "folder": "controlnet",
      "file": "controlnet-depth-sdxl-1.0.safetensors",
      "purpose": "depth conditioning (xinsir, SDXL)"
    },
    {
      "folder": "host:studio/tools/vision-models",
      "file": "depth-anything-v2-small.onnx",
      "purpose": "host-side depth estimation, ONNX Runtime CPU"
    }
  ],
  "notes": "The depth map is produced by studio/tools/vision/vision_cli.py in its own venv (onnxruntime only — the container never gets OpenCV). Depth-Anything V2 runs at 518x518 keeping the aspect ratio and pads the remainder, so the map matches the framing of the original instead of being squash-stretched. The map is scaled to the exact latent size before the ControlNet, and the job keeps it as a second output so you can see what the sampler was given. Depth strength 0.75 with end_percent 0.9 lets colour and texture drift while the geometry holds.",
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_turbo_1.0_fp16.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "a wooden cabin on a mountain ridge at golden hour, pine forest, dramatic clouds, cinematic light, high detail",
        "clip": ["1", 1]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, watermark, text, deformed, flat lighting",
        "clip": ["1", 1]
      }
    },
    "4": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "5": {
      "class_type": "ImageScale",
      "inputs": {
        "image": ["4", 0],
        "upscale_method": "lanczos",
        "width": 1024,
        "height": 1024,
        "crop": "center"
      }
    },
    "6": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "controlnet-depth-sdxl-1.0.safetensors"
      }
    },
    "7": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": ["2", 0],
        "negative": ["3", 0],
        "control_net": ["6", 0],
        "image": ["5", 0],
        "strength": 0.75,
        "start_percent": 0.0,
        "end_percent": 0.9
      }
    },
    "8": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "9": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["7", 0],
        "negative": ["7", 1],
        "latent_image": ["8", 0],
        "seed": 23,
        "steps": 8,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["9", 0],
        "vae": ["1", 2]
      }
    },
    "11": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["10", 0],
        "filename_prefix": "studio/cn_depth"
      }
    }
  },
  "parameters": [
    {
      "key": "image",
      "label": "Photo to follow",
      "type": "image",
      "default": "ref_raccoon.png",
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      },
      "description": "Upload a photo. Only its depth structure is used — the colours come from the prompt."
    },
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "multiline": true,
      "bind": {
        "node": "2",
        "input": "text"
      },
      "default": "a wooden cabin on a mountain ridge at golden hour, pine forest, dramatic clouds, cinematic light, high detail",
      "required": true
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "multiline": true,
      "bind": {
        "node": "3",
        "input": "text"
      },
      "default": "blurry, low quality, watermark, text, deformed, flat lighting"
    },
    {
      "key": "strength",
      "label": "Depth strength",
      "type": "float",
      "bind": {
        "node": "7",
        "input": "strength"
      },
      "default": 0.75,
      "min": 0.0,
      "max": 1.5,
      "step": 0.05
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "bind": {
        "node": "9",
        "input": "steps"
      },
      "default": 8,
      "min": 1,
      "max": 20,
      "step": 1
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "bind": {
        "node": "9",
        "input": "cfg"
      },
      "default": 1.0,
      "min": 1.0,
      "max": 3.0,
      "step": 0.1
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "bind": {
        "node": "9",
        "input": "seed"
      },
      "default": 23,
      "seed_source": true
    }
  ]
}
