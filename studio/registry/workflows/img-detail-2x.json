{
  "id": "img-detail-2x",
  "name": "Upscale 2× with recovered detail — RealESRGAN",
  "category": "image-enhancement",
  "description": "RealESRGAN runs at its native 4x, then an area filter brings the result back to 2x. You get real invented detail without a 4096 px monster file.",
  "execution": "graph",
  "graph": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "ref_raccoon.png"
      }
    },
    "2": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "RealESRGAN_x4.pth"
      }
    },
    "3": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": [
          "2",
          0
        ],
        "image": [
          "1",
          0
        ]
      }
    },
    "4": {
      "class_type": "ImageScaleBy",
      "inputs": {
        "image": [
          "3",
          0
        ],
        "upscale_method": "area",
        "scale_by": 0.5
      }
    },
    "5": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/detail2x",
        "images": [
          "4",
          0
        ]
      }
    }
  },
  "output_kind": "image",
  "timeout_s": 300,
  "min_vram_gb": 6,
  "tags": [
    "upscale",
    "realesrgan",
    "detail",
    "2x",
    "no-download"
  ],
  "models": [
    {
      "folder": "upscale_models",
      "file": "RealESRGAN_x4.pth",
      "purpose": "4x upscaler"
    }
  ],
  "parameters": [
    {
      "key": "image",
      "label": "Photo",
      "type": "image",
      "default": "ref_raccoon.png",
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      },
      "bind": {
        "node": "1",
        "input": "image"
      }
    },
    {
      "key": "shrink",
      "label": "Final factor",
      "type": "float",
      "default": 0.5,
      "min": 0.1,
      "max": 1.0,
      "step": 0.05,
      "bind": {
        "node": "4",
        "input": "scale_by"
      }
    }
  ],
  "notes": "0.5 gives 2x, 0.75 gives 3x, 1.0 keeps the raw 4x. On a 1024 px source the raw 4x pass allocates roughly 1.5 GB of VRAM before the shrink."
}
