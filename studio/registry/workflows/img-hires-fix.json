{
  "id": "img-hires-fix",
  "name": "Image — hires fix (sample, upscale, resample)",
  "category": "image-generation",
  "description": "Classic two-pass: sample at a speed-friendly size, upscale the latent 1.5×, then resample at denoise 0.5 so the extra pixels get real detail.",
  "execution": "graph",
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_turbo_1.0_fp16.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "a lighthouse on a rocky cliff at dawn, dramatic clouds, wide landscape, photographic",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, watermark, text, deformed, extra fingers",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 832,
        "height": 832,
        "batch_size": 1
      }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 42,
        "steps": 6,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": [
          "1",
          0
        ],
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "4",
          0
        ]
      }
    },
    "6": {
      "class_type": "LatentUpscale",
      "inputs": {
        "samples": [
          "5",
          0
        ],
        "upscale_method": "nearest-exact",
        "width": 1248,
        "height": 1248,
        "crop": "disabled"
      }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 42,
        "steps": 6,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.5,
        "model": [
          "1",
          0
        ],
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "6",
          0
        ]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "7",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/hires",
        "images": [
          "8",
          0
        ]
      }
    }
  },
  "output_kind": "image",
  "timeout_s": 420,
  "min_vram_gb": 12,
  "tags": [
    "hires",
    "two-pass",
    "upscale",
    "sdxl-turbo",
    "no-download"
  ],
  "models": [
    {
      "folder": "checkpoints",
      "file": "sd_xl_turbo_1.0_fp16.safetensors",
      "purpose": "SDXL-Turbo base model (4-step sampling)"
    }
  ],
  "parameters": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "multiline": true,
      "default": "a lighthouse on a rocky cliff at dawn, dramatic clouds, wide landscape, photographic",
      "required": true,
      "bind": {
        "node": "2",
        "input": "text"
      }
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "multiline": true,
      "default": "blurry, low quality, watermark, text, deformed, extra fingers",
      "bind": {
        "node": "3",
        "input": "text"
      }
    },
    {
      "key": "width",
      "label": "Width",
      "type": "int",
      "default": 832,
      "min": 256,
      "max": 2048,
      "step": 8,
      "bind": {
        "node": "4",
        "input": "width"
      }
    },
    {
      "key": "height",
      "label": "Height",
      "type": "int",
      "default": 832,
      "min": 256,
      "max": 2048,
      "step": 8,
      "bind": {
        "node": "4",
        "input": "height"
      }
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 6,
      "min": 1,
      "max": 20,
      "bind": {
        "node": "5",
        "input": "steps"
      }
    },
    {
      "key": "cfg",
      "label": "CFG scale",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 12.0,
      "step": 0.1,
      "bind": {
        "node": "5",
        "input": "cfg"
      }
    },
    {
      "key": "denoise",
      "label": "Second pass denoise",
      "type": "float",
      "default": 0.5,
      "min": 0.2,
      "max": 0.9,
      "step": 0.05,
      "bind": {
        "node": "7",
        "input": "denoise"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 42,
      "bind": {
        "node": "5",
        "input": "seed"
      }
    }
  ],
  "notes": "Denoise above 0.6 on the second pass repaints the composition instead of adding detail; 0.45–0.55 is the useful band."
}
