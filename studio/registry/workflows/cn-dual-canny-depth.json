{
  "id": "cn-dual-canny-depth",
  "name": "ControlNet — canny + depth together",
  "category": "image-generation",
  "description": "Two ControlNets in one pass: Canny locks the silhouette from the photo itself, Depth (generated on the host) locks the volume. The combination holds shape far better than either alone.",
  "execution": "chain",
  "host_tool": "depth_map",
  "chain_bind": {
    "node": "4",
    "input": "image"
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_turbo_1.0_fp16.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "a red fox in a mossy forest, cinematic light, detailed fur, photographic",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, watermark, text, deformed, extra fingers",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "depth_placeholder.png"
      }
    },
    "20": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "ref_raccoon.png"
      }
    },
    "5": {
      "class_type": "Canny",
      "inputs": {
        "image": [
          "20",
          0
        ],
        "low_threshold": 0.4,
        "high_threshold": 0.8
      }
    },
    "6": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "controlnet-canny-sdxl-1.0.safetensors"
      }
    },
    "7": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "control_net": [
          "6",
          0
        ],
        "image": [
          "5",
          0
        ],
        "strength": 0.15,
        "start_percent": 0.0,
        "end_percent": 0.6
      }
    },
    "8": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "controlnet-depth-sdxl-1.0.safetensors"
      }
    },
    "9": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": [
          "7",
          0
        ],
        "negative": [
          "7",
          1
        ],
        "control_net": [
          "8",
          0
        ],
        "image": [
          "4",
          0
        ],
        "strength": 0.4,
        "start_percent": 0.0,
        "end_percent": 0.85
      }
    },
    "10": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "11": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 11,
        "steps": 8,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": [
          "1",
          0
        ],
        "positive": [
          "9",
          0
        ],
        "negative": [
          "9",
          1
        ],
        "latent_image": [
          "10",
          0
        ]
      }
    },
    "12": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "11",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "13": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/cn_dual",
        "images": [
          "12",
          0
        ]
      }
    }
  },
  "output_kind": "image",
  "timeout_s": 600,
  "min_vram_gb": 12,
  "tags": [
    "controlnet",
    "canny",
    "depth",
    "chain",
    "host-tool",
    "no-download"
  ],
  "models": [
    {
      "folder": "checkpoints",
      "file": "sd_xl_turbo_1.0_fp16.safetensors",
      "purpose": "SDXL-Turbo base model (4-step sampling)"
    },
    {
      "folder": "controlnet",
      "file": "controlnet-canny-sdxl-1.0.safetensors",
      "purpose": "Canny ControlNet (SDXL)"
    },
    {
      "folder": "controlnet",
      "file": "controlnet-depth-sdxl-1.0.safetensors",
      "purpose": "Depth ControlNet (SDXL)"
    },
    {
      "folder": "host:studio/tools/vision-models",
      "file": "depth-anything-v2-small.onnx",
      "purpose": "Depth-Anything V2 Small, ONNX Runtime CPU"
    }
  ],
  "parameters": [
    {
      "key": "image",
      "label": "Photo",
      "type": "image",
      "default": "ref_raccoon.png",
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      },
      "bind": {
        "node": "20",
        "input": "image"
      }
    },
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "multiline": true,
      "default": "a red fox in a mossy forest, cinematic light, detailed fur, photographic",
      "required": true,
      "bind": {
        "node": "2",
        "input": "text"
      }
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "multiline": true,
      "default": "blurry, low quality, watermark, text, deformed, extra fingers",
      "bind": {
        "node": "3",
        "input": "text"
      }
    },
    {
      "key": "canny_strength",
      "label": "Canny strength",
      "type": "float",
      "default": 0.15,
      "min": 0.0,
      "max": 1.5,
      "step": 0.05,
      "bind": {
        "node": "7",
        "input": "strength"
      }
    },
    {
      "key": "depth_strength",
      "label": "Depth strength",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 1.5,
      "step": 0.05,
      "bind": {
        "node": "9",
        "input": "strength"
      }
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 8,
      "min": 1,
      "max": 30,
      "bind": {
        "node": "11",
        "input": "steps"
      }
    },
    {
      "key": "cfg",
      "label": "CFG scale",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 12.0,
      "step": 0.1,
      "bind": {
        "node": "11",
        "input": "cfg"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 11,
      "bind": {
        "node": "11",
        "input": "seed"
      }
    }
  ],
  "notes": "Two 2.5 GiB ControlNets plus the checkpoint are resident at once — this is the heaviest image workflow in the studio (about 12 GiB of models). The strengths are measured, not guessed: at canny 0.45 / depth 0.6 the sampler paints the source edge map into the result as white contour lines, at 0.15 / 0.4 it does not while the pose still holds."
}
