{
  "id": "tts-en-piper",
  "name": "English speech \u2014 Piper",
  "category": "audio-generation",
  "description": "English counterpart of the Russian TTS workflow \u2014 same CPU-only Piper pipeline, lessac voice.",
  "execution": "host",
  "host_tool": "piper_tts",
  "output_kind": "audio",
  "timeout_s": 120,
  "min_vram_gb": 0,
  "tags": [
    "tts",
    "speech",
    "english",
    "piper",
    "cpu",
    "host-tool",
    "no-gpu"
  ],
  "models": [],
  "notes": "Voice model: rhasspy/piper-voices en_US-lessac-medium, MIT. CPU only, ~20x realtime.",
  "parameters": [
    {
      "key": "text",
      "label": "Text to speak",
      "type": "text",
      "multiline": true,
      "required": true,
      "default": "This is a fully local text to speech pipeline. No cloud, no API keys."
    },
    {
      "key": "voice",
      "label": "Voice",
      "type": "choice",
      "options": [
        "en_US-lessac-medium"
      ],
      "default": "en_US-lessac-medium",
      "required": true
    },
    {
      "key": "length_scale",
      "label": "Speed (1.0 = normal, higher = slower)",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05
    }
  ]
}