{
  "id": "sam-overlay",
  "name": "Mask preview — by point (MobileSAM)",
  "category": "image-editing",
  "description": "Draws the mask over the photo in red so you can see what will be cut before committing to a 30-step edit.",
  "execution": "host",
  "host_tool": "sam_segment",
  "output_kind": "image",
  "timeout_s": 300,
  "tags": [
    "segmentation",
    "sam",
    "mobilesam",
    "mask",
    "cpu",
    "mask",
    "preview"
  ],
  "models": [
    {
      "folder": "host:studio/tools/vision-models",
      "file": "mobilesam.encoder.onnx",
      "purpose": "MobileSAM ViT-T encoder (ONNX, CPU)"
    },
    {
      "folder": "host:studio/tools/vision-models",
      "file": "mobilesam.decoder.onnx",
      "purpose": "MobileSAM mask decoder (ONNX, CPU)"
    }
  ],
  "parameters": [
    {
      "key": "image",
      "label": "Photo",
      "type": "image",
      "default": "ref_raccoon.png",
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      }
    },
    {
      "key": "points",
      "label": "Points to the object (x,y;x,y — empty means centre)",
      "type": "string",
      "default": ""
    },
    {
      "key": "labels",
      "label": "Labels (1=object, 0=background; empty = all 1)",
      "type": "string",
      "default": ""
    },
    {
      "key": "mode",
      "label": "Output",
      "type": "choice",
      "options": [
        "overlay"
      ],
      "default": "overlay"
    }
  ],
  "notes": "MobileSAM on ONNX Runtime, CPU only, ~1.5 s for a 1024² photo. The mask is the thing under the point you give it — unlike U²-Net's cutout, which always answers 'the most salient object'."
}
