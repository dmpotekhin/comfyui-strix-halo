{
  "id": "image-resize",
  "name": "Smart resize / prepare for upload",
  "category": "image-enhancement",
  "description": "Resample an image to a target scale with a choice of filter. Lanczos is the safe default; area is better for large downscales; nearest-exact keeps pixel art crisp.",
  "output_kind": "image",
  "min_vram_gb": 2,
  "tags": [
    "resize",
    "prepare",
    "utility",
    "no-model"
  ],
  "models": [],
  "notes": "Pure resampling — no model is involved, so this workflow runs instantly and has no licence implications.",
  "graph": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "example.png"
      }
    },
    "2": {
      "class_type": "ImageScaleBy",
      "inputs": {
        "image": [
          "1",
          0
        ],
        "upscale_method": "lanczos",
        "scale_by": 2.0
      }
    },
    "3": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/resized",
        "images": [
          "2",
          0
        ]
      }
    }
  },
  "parameters": [
    {
      "key": "image",
      "label": "Source image",
      "type": "image",
      "bind": {
        "node": "1",
        "input": "image"
      },
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      },
      "default": "example.png"
    },
    {
      "key": "scale_by",
      "label": "Scale factor",
      "type": "float",
      "bind": {
        "node": "2",
        "input": "scale_by"
      },
      "default": 2.0,
      "min": 0.05,
      "max": 8.0,
      "step": 0.05,
      "description": "2.0 doubles both dimensions. 0.5 halves them."
    },
    {
      "key": "method",
      "label": "Filter",
      "type": "choice",
      "bind": {
        "node": "2",
        "input": "upscale_method"
      },
      "default": "lanczos",
      "options_from": {
        "class_type": "ImageScaleBy",
        "input": "upscale_method"
      }
    }
  ]
}
