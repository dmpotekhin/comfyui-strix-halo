{
  "id": "inpaint-turbo",
  "name": "Inpaint — replace part of an image (mask)",
  "category": "image-editing",
  "description": "Regenerate the masked area and keep everything else. The mask is taken from the alpha channel of the uploaded PNG, so paint the area to replace with transparency (or with white on an alpha layer) before uploading.",
  "output_kind": "image",
  "min_vram_gb": 8,
  "tags": [
    "inpaint",
    "mask",
    "edit",
    "turbo"
  ],
  "models": [
    {
      "folder": "checkpoints",
      "file": "sd_xl_turbo_1.0_fp16.safetensors",
      "purpose": "base model"
    }
  ],
  "notes": "The mask comes from the image's alpha channel only, so the upload must be a PNG with a genuinely transparent area. 'grow_mask_by' expands the mask to hide seams. Tuned for object replacement, not for large structural changes — the prompt should describe an object, not a new scene.",
  "test_status": "passed",
  "tested_at": "2026-10-26",
  "test_evidence": "Job completed in 5.1 s on 2026-10-26 producing inpaint_00002_.png (512x512, 444 KB). Verified visually: the masked region (100,140)-(220,260) was regenerated while the rest of the image was preserved. An earlier run against an image without an alpha channel completed but changed nothing, which is why requires_alpha is set and checked in preflight.",
  "requires_alpha": true,
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_turbo_1.0_fp16.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "an empty stone terrace, overcast daylight, photorealistic",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, watermark, text, deformed, extra limbs",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "example.png"
      }
    },
    "5": {
      "class_type": "VAEEncodeForInpaint",
      "inputs": {
        "pixels": [
          "4",
          0
        ],
        "vae": [
          "1",
          2
        ],
        "mask": [
          "4",
          1
        ],
        "grow_mask_by": 6
      }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 5,
        "steps": 4,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0,
        "model": [
          "1",
          0
        ],
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "5",
          0
        ]
      }
    },
    "7": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "6",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "8": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/inpaint",
        "images": [
          "7",
          0
        ]
      }
    }
  },
  "parameters": [
    {
      "key": "image",
      "label": "Image with mask (alpha)",
      "type": "image",
      "bind": {
        "node": "4",
        "input": "image"
      },
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      },
      "default": "mask_test.png"
    },
    {
      "key": "prompt",
      "label": "What should be there",
      "type": "text",
      "bind": {
        "node": "2",
        "input": "text"
      },
      "required": true,
      "multiline": true,
      "default": "an empty stone terrace, overcast daylight, photorealistic"
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "bind": {
        "node": "3",
        "input": "text"
      },
      "multiline": true,
      "default": "blurry, low quality, watermark, text, deformed, extra limbs"
    },
    {
      "key": "grow_mask_by",
      "label": "Expand mask",
      "type": "int",
      "bind": {
        "node": "5",
        "input": "grow_mask_by"
      },
      "default": 6,
      "min": 0,
      "max": 64,
      "unit": "px",
      "description": "Grows the masked area to blend the new content into its surroundings."
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "bind": {
        "node": "6",
        "input": "steps"
      },
      "default": 4,
      "min": 1,
      "max": 8
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "bind": {
        "node": "6",
        "input": "cfg"
      },
      "default": 1.0,
      "min": 1.0,
      "max": 2.0,
      "step": 0.1
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "bind": {
        "node": "6",
        "input": "seed"
      },
      "default": -1,
      "seed_source": true
    }
  ]
}
