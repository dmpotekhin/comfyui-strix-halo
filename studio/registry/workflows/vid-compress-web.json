{
  "id": "vid-compress-web",
  "name": "Video — compress for the web",
  "category": "video-generation",
  "description": "CRF 26 capped at 1280 px: a shareable file at a fraction of a camera original.",
  "execution": "host",
  "host_tool": "ffmpeg_video_compress",
  "output_kind": "video",
  "timeout_s": 900,
  "min_vram_gb": 0,
  "tags": [
    "host-tool",
    "no-gpu",
    "ffmpeg_video_compress"
  ],
  "models": [],
  "parameters": [
    {
      "key": "video",
      "label": "Video file (name in input/ or path in project)",
      "type": "string",
      "default": "output/studio/i2v_00002_.mp4",
      "required": true
    },
    {
      "key": "crf",
      "label": "x264 CRF",
      "type": "int",
      "default": 26,
      "min": 0,
      "max": 51
    },
    {
      "key": "preset",
      "label": "Encoder preset",
      "type": "choice",
      "options": [
        "ultrafast",
        "fast",
        "medium",
        "slow",
        "veryslow"
      ],
      "default": "medium"
    },
    {
      "key": "max_width",
      "label": "Max width (0 = keep)",
      "type": "int",
      "default": 1280,
      "min": 0,
      "max": 7680
    }
  ],
  "notes": "Higher CRF means smaller and softer. `fast`/`medium` are the sensible compromise on this machine; `veryslow` buys a few percent for minutes."
}
