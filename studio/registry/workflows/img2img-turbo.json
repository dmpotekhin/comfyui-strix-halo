{
  "id": "img2img-turbo",
  "name": "Fast Restyle \u2014 SDXL Turbo img2img",
  "category": "image-editing",
  "description": "Restyles an existing image in a few seconds with SDXL Turbo: the source is VAE-encoded and re-sampled at low denoise. Turbo wants cfg 1.0 and 1-4 steps; more steps only add time. Low denoise keeps the composition, high denoise invents a new one.",
  "output_kind": "image",
  "min_vram_gb": 10,
  "tags": [
    "img2img",
    "restyle",
    "turbo",
    "fast",
    "sdxl"
  ],
  "models": [
    {
      "folder": "checkpoints",
      "file": "animagine-xl-4.0.safetensors",
      "purpose": "base model"
    }
  ],
  "notes": "Turbo is a distilled model: cfg above ~1.5 burns the image. Denoise 0.3-0.45 restyles, 0.6-0.75 regenerates. Same weights as txt2img-turbo, so no extra disk. CC BY-NC-SA 4.0 \u2014 non-commercial.",
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_turbo_1.0_fp16.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "oil painting, thick visible brush strokes, warm palette",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, watermark, text, deformed",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "style_00001_.png"
      }
    },
    "5": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "4",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 7,
        "steps": 4,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.45,
        "model": [
          "1",
          0
        ],
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "5",
          0
        ]
      }
    },
    "7": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "6",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "8": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "studio/restyle_turbo",
        "images": [
          "7",
          0
        ]
      }
    }
  },
  "parameters": [
    {
      "key": "image",
      "label": "Source image",
      "type": "image",
      "bind": {
        "node": "4",
        "input": "image"
      },
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      },
      "default": "style_00001_.png"
    },
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "bind": {
        "node": "2",
        "input": "text"
      },
      "required": true,
      "multiline": true,
      "default": "a photo of a cat, natural colours, detailed fur"
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "bind": {
        "node": "3",
        "input": "text"
      },
      "multiline": true,
      "default": "blurry, low quality, watermark, text, deformed"
    },
    {
      "key": "denoise",
      "label": "Strength",
      "type": "float",
      "bind": {
        "node": "6",
        "input": "denoise"
      },
      "default": 0.45,
      "min": 0.05,
      "max": 1.0,
      "step": 0.05,
      "description": "How far to move away from the source image. 0.2 = gentle, 1.0 = ignore the source completely."
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "bind": {
        "node": "6",
        "input": "steps"
      },
      "default": 4,
      "min": 1,
      "max": 12
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "bind": {
        "node": "6",
        "input": "cfg"
      },
      "default": 1.0,
      "min": 1.0,
      "max": 2.0,
      "step": 0.5
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "bind": {
        "node": "6",
        "input": "seed"
      },
      "default": -1,
      "seed_source": true
    }
  ]
}