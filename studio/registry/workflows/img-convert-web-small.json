{
  "id": "img-convert-web-small",
  "name": "Convert — WebP for the web (1280 px)",
  "category": "image-editing",
  "description": "WebP, quality 78, capped at 1280 px on the long side: the standard blog-post image, produced in well under a second.",
  "execution": "host",
  "host_tool": "image_convert",
  "output_kind": "image",
  "timeout_s": 900,
  "min_vram_gb": 0,
  "tags": [
    "host-tool",
    "no-gpu",
    "image_convert"
  ],
  "models": [],
  "parameters": [
    {
      "key": "image",
      "label": "Photo",
      "type": "image",
      "default": "ref_raccoon.png",
      "required": true,
      "options_from": {
        "class_type": "LoadImage",
        "input": "image"
      }
    },
    {
      "key": "format",
      "label": "Output format",
      "type": "choice",
      "options": [
        "webp",
        "jpg"
      ],
      "default": "webp"
    },
    {
      "key": "quality",
      "label": "Quality",
      "type": "int",
      "default": 78,
      "min": 1,
      "max": 100
    },
    {
      "key": "max_side",
      "label": "Max longest side",
      "type": "int",
      "default": 1280,
      "min": 0,
      "max": 8192
    }
  ],
  "notes": "Only shrinks — an image already smaller than max_side is re-encoded at its own size, never upscaled."
}
