{
  "id": "audio-fade",
  "name": "Fade — in and out",
  "category": "audio-generation",
  "description": "Ramps the first and last moments of a take so it does not start or end with a click.",
  "execution": "host",
  "host_tool": "ffmpeg_fade_audio",
  "output_kind": "audio",
  "timeout_s": 900,
  "min_vram_gb": 0,
  "tags": [
    "host-tool",
    "no-gpu",
    "ffmpeg_fade_audio"
  ],
  "models": [],
  "parameters": [
    {
      "key": "audio",
      "label": "Audio file (name in input/ or path in project)",
      "type": "string",
      "default": "output/studio/tts_ru_RU_00001_.wav",
      "required": true
    },
    {
      "key": "fade_in",
      "label": "Fade in",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 60,
      "step": 0.05,
      "unit": "s"
    },
    {
      "key": "fade_out",
      "label": "Fade out",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 60,
      "step": 0.05,
      "unit": "s"
    }
  ],
  "notes": "The fade-out start is computed from the real duration via ffprobe, so it lands on the end of the file rather than at a guessed offset."
}
