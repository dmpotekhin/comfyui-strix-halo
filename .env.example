# Скопируй в .env и правь при необходимости. Значения по умолчанию работают и без .env.
# Образ: Docker Hub (ghcr.io-зеркала не существует). Тега latest нет — фиксируем v0.2.
COMFY_IMAGE=ignatberesnev/comfyui-gfx1151:v0.2
COMFY_NAME=comfyui-strix-halo
# Порт слушается только на 127.0.0.1 (см. compose.yaml)
COMFY_PORT=8188
# /dev/shm контейнера; хост-RAM всего ~30 GiB
COMFY_SHM=4g
